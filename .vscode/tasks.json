{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Debug",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/.vscode/Build.ps1",
                "-Configuration",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Release",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/.vscode/Build.ps1",
                "-Configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Shipping",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File",
                "${workspaceFolder}/.vscode/Build.ps1",
                "-Configuration",
                "Shipping"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
