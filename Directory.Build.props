<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CanapeRoot>$(MSBuildThisFileDirectory)</CanapeRoot>
    <OutDir>$(CanapeRoot)Binaries\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(CanapeRoot)Intermediate\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <CanapeRenderDebug Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Release'">1</CanapeRenderDebug>
    <CanapeRenderDebug Condition="'$(Configuration)'=='Shipping'">0</CanapeRenderDebug>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(CanapeRoot)</VcpkgManifestRoot>
    <VcpkgTriplet>x64-windows-static-md</VcpkgTriplet>
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
    <VcpkgConfiguration Condition="'$(Configuration)'=='Debug'">Debug</VcpkgConfiguration>
    <VcpkgConfiguration Condition="'$(Configuration)'!='Debug'">Release</VcpkgConfiguration>
  </PropertyGroup>
</Project>
